[Unit]
Description=DEMI backfill ingest — replay out/*.md into Azure
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/gpu-extractor
EnvironmentFile=/root/gpu-extractor/gpu-extractor.env
# After the EnvironmentFile so it wins over any value there.
Environment=MAX_RUN_FAILURES=3
ExecStart=/root/gpu-extractor/venv/bin/python /root/gpu-extractor/ingest.py
# ingest.py drains out/ and exits 0, so "restart always" is the loop: every 5 minutes it picks up
# whatever the extractor has produced since. Restart=on-failure would never fire on a clean exit.
# This loop is bounded: a 4xx moves the file to dead/ at once, and a 5xx or transport failure
# moves it to dead/ after MAX_RUN_FAILURES runs in a row, so no file is posted forever. A run with
# an empty out/ exits before any network call.
Restart=always
RestartSec=300
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
