[Unit]
Description=Document Ingestion & GPU OCR Service (Docling)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/doc-ocr-service
ExecStart=/opt/doc-ocr-service/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
