              "type": "string",
              "defaultValue": "[if(equals(parameters('environmentName'), 'prod'), 'https://loginproxy.gov.bc.ca/auth', if(equals(parameters('environmentName'), 'test'), 'https://test.loginproxy.gov.bc.ca/auth', 'https://dev.loginproxy.gov.bc.ca/auth'))]",
              "metadata": {
                "description": "Keycloak base URL for this environment (dev/test/prod loginproxy)"
              }
            },
            "keycloakRealm": {
              "type": "string",
              "defaultValue": "eao-epic",
              "metadata": {
