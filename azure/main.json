                    {
                      "name": "COSMOSDB_URI",
                      "value": "[parameters('mongodbConnectionString')]"
                    },
                    {
                      "name": "COSMOSDB_DATABASE",
                      "value": "epic"
                    },
                    {
                      "name": "MONGODB_URI",
                      "value": "[parameters('mongodbConnectionString')]"
                    },
                    {
                      "name": "MONGODB_DATABASE",
                      "value": "epic"
                    },
                    {
                      "name": "MINIO_HOST",
                      "value": "[parameters('minioHost')]"
                    },
                    {
                      "name": "MINIO_ACCESS_KEY",
                      "value": "[parameters('minioAccessKey')]"
                    },
                    {
                      "name": "MINIO_SECRET_KEY",
                      "value": "[parameters('minioSecretKey')]"
                    },
                    {
                      "name": "SEARCH_ENDPOINT",
                      "value": "[parameters('searchEndpoint')]"
                    },
                    {
                      "name": "SEARCH_INDEX",
                      "value": "[parameters('searchIndex')]"
                    },
                    {
                      "name": "KEYCLOAK_URL",
                      "value": "[parameters('keycloakUrl')]"
                    },
                    {
                      "name": "KEYCLOAK_REALM",
                      "value": "[parameters('keycloakRealm')]"
                    },
                    {
                      "name": "KEYCLOAK_ENABLED",
                      "value": "true"
                    },
                    {
                      "name": "SSO_ISSUER",
                      "value": "[format('{0}/realms/{1}', parameters('keycloakUrl'), parameters('keycloakRealm'))]"
                    },
                    {
                      "name": "SSO_JWKSURI",
                      "value": "[format('{0}/realms/{1}/protocol/openid-connect/certs', parameters('keycloakUrl'), parameters('keycloakRealm'))]"
                    },
                    {
                      "name": "CORS_ORIGIN",
                      "value": "[format('https://demi-frontend-{0}.azurewebsites.net', parameters('environmentName'))]"
                    },
                    {
                      "name": "SCM_DO_BUILD_DURING_DEPLOYMENT",
                      "value": "false"
                    },
                    {
                      "name": "WEBSITE_HTTPLOGGING_RETENTION_DAYS",
                      "value": "3"
                    }
                  ],
                  "cors": {
                    "allowedOrigins": [
                      "https://portal.azure.com",
                      "[format('https://demi-frontend-{0}.azurewebsites.net', parameters('environmentName'))]",
                      "[format('https://demi-frontend-swa-{0}.azurestaticapps.net', parameters('environmentName'))]"
                    ]
                  }
                }
              },
              "dependsOn": [
                "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]",
                "[resourceId('Microsoft.Web/serverfarms', variables('appServicePlanName'))]"
              ]
            }
          ],
          "outputs": {
            "apiWebAppName": {
              "type": "string",
              "value": "[variables('apiAppName')]"
            },
            "apiWebAppHostName": {
              "type": "string",
