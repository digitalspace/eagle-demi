              "metadata": {
                "description": "Location for Cosmos DB Account"
              }
            },
            "environmentName": {
              "type": "string",
              "metadata": {
                "description": "Environment name (e.g. dev, test, prod)"
              }
            },
            "tags": {
              "type": "object",
              "metadata": {
                "description": "Default resource tags"
              }
            },
            "peSubnetId": {
              "type": "string",
              "defaultValue": "",
              "metadata": {
                "description": "Subnet ID for Private Endpoint (optional)"
              }
            }
          },
          "variables": {
            "accountName": "[format('demi-cosmos-{0}-{1}', parameters('environmentName'), uniqueString(resourceGroup().id))]",
            "databaseName": "[format('demi-{0}', parameters('environmentName'))]",
            "privateEndpointName": "[format('pe-cosmos-{0}', parameters('environmentName'))]"
          },
          "resources": {
            "cosmosAccount": {
              "type": "Microsoft.DocumentDB/databaseAccounts",
              "apiVersion": "2023-11-15",
              "name": "[variables('accountName')]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "kind": "MongoDB",
              "properties": {
                "databaseAccountOfferType": "Standard",
                "publicNetworkAccess": "[if(not(empty(parameters('peSubnetId'))), 'Disabled', 'Enabled')]",
                "disableKeyBasedMetadataWriteAccess": true,
                "minimalTlsVersion": "Tls12",
                "apiProperties": {
                  "serverVersion": "7.0"
                },
                "capabilities": [
                  {
                    "name": "EnableServerless"
                  }
                ],
                "locations": [
                  {
                    "locationName": "[parameters('location')]",
                    "failoverPriority": 0,
                    "isZoneRedundant": false
                  }
                ]
              }
            },
            "cosmosDatabase": {
              "type": "Microsoft.DocumentDB/databaseAccounts/mongodbDatabases",
              "apiVersion": "2023-11-15",
              "name": "[format('{0}/{1}', variables('accountName'), variables('databaseName'))]",
              "properties": {
                "resource": {
                  "id": "[variables('databaseName')]"
                }
              },
              "dependsOn": [
                "cosmosAccount"
              ]
            },
            "privateEndpoint": {
              "condition": "[not(empty(parameters('peSubnetId')))]",
              "type": "Microsoft.Network/privateEndpoints",
              "apiVersion": "2023-09-01",
              "name": "[variables('privateEndpointName')]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "properties": {
                "subnet": {
                  "id": "[parameters('peSubnetId')]"
                },
                "privateLinkServiceConnections": [
                  {
                    "name": "[variables('privateEndpointName')]",
                    "properties": {
                      "privateLinkServiceId": "[resourceId('Microsoft.DocumentDB/databaseAccounts', variables('accountName'))]",
                      "groupIds": [
                        "MongoDB"
                      ]
                    }
                  }
                ]
              },
              "dependsOn": [
                "cosmosAccount"
              ]
            }
          },
          "outputs": {
            "connectionString": {
              "type": "securestring",
              "value": "[listConnectionStrings('cosmosAccount', '2023-11-15').connectionStrings[0].connectionString]"
            },
            "databaseName": {
              "type": "string",
              "value": "[variables('databaseName')]"
            },
            "cosmosAccountId": {
              "type": "string",
              "value": "[resourceId('Microsoft.DocumentDB/databaseAccounts', variables('accountName'))]"
            }
          }
        }
      },
      "dependsOn": [
        "vnet"
      ]
    },
    "apiWebApp": {
