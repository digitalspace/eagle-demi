# Dependency directories
node_modules

# Environment files
.env
.env.local
.env.*.local

# Copilot / agent instruction files (local only, not for review)
.github/antigravity.md
.github/instructions/

# Editor
.vscode/settings.json
.idea/

# OS
.DS_Store
Thumbs.db
CLAUDE.md

# Temporary files
tmp/
*.zip
*.tar.gz

# Lock files (Yarn 4 project)
package-lock.json

# Built frontend static & distribution.
# Anchored to the repo root: an unanchored `public/` also matched frontend/public/, which is
# Angular's SOURCE asset dir, not build output. That silently untracked the boundary GeoJSON and
# made `scripts/package-api.py` hard-fail on a clean clone.
/public/
dist/
.angular/

# Deploy archives
.deploy_archives/

# Local scratch
scratch/

# Browser-automation output (console logs, page snapshots) from a debugging session.
.playwright-mcp/

# Yarn 4 install state (regenerated by `yarn install`, never a source of truth —
# yarn.lock is). Unanchored so it catches `frontend/.yarn/` too: the old
# `.yarn/install-state.gz` form matched only the repo root, and both copies were
# tracked anyway, which no ignore rule can undo. They are untracked as of
# 2026-08-05 — 1.5 MB of binary that changed on all 16 commits that touched it,
# and rode along in every Dependabot PR.
**/.yarn/install-state.gz

# Local agent state. `.claude/worktrees/` holds whole checkouts of this repo —
# committing it would nest the repository inside itself.
.claude/



# Python bytecode — the extractor is Python inside a Node repo
__pycache__/
*.pyc
