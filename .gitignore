package-lock.json

# Built frontend static & distribution.
# Anchored to the repo root: an unanchored `public/` also matched frontend/public/, which is
# Angular's SOURCE asset dir, not build output. That silently untracked the boundary GeoJSON and
# made `scripts/package-api.py` hard-fail on a clean clone.
/public/
dist/
.angular/

# Deploy archives
.deploy_archives/

# Local scratch
scratch/

# Yarn 4 install state (regenerated by `yarn install`)
.yarn/install-state.gz

# Local agent state. `.claude/worktrees/` holds whole checkouts of this repo —
# committing it would nest the repository inside itself.
.claude/


