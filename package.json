{
  "name": "eagle-demi",
  "version": "1.0.0",
  "description": "DEMI central repository and extraction worker API",
  "main": "api/index.js",
  "scripts": {
    "start": "node src/server.js",
    "extract": "node src/extract.js",
    "extract:retry": "node src/extract.js --retry-failed",
    "extract:doc": "node src/extract.js --doc-id",
    "db:seed-nosql": "NODE_PATH=node_modules node -r dotenv/config src/scripts/seed-nosql.js",
    "db:copy-blobs": "NODE_PATH=node_modules node -r dotenv/config src/scripts/copy-blobs-to-azure.js",
    "db:purge-extraction": "NODE_PATH=node_modules node -r dotenv/config src/scripts/purge-extraction.js",
    "deploy:azure": "bash scripts/deploy-azure.sh all",
    "deploy:azure:api": "bash scripts/deploy-azure.sh api",
    "deploy:azure:frontend": "bash scripts/deploy-azure.sh frontend",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --test 'test/**/*.test.js'"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@azure/cosmos": "^4.10.0",
    "@azure/functions": "^4.5.0",
    "@azure/identity": "^4.13.1",
    "@azure/storage-blob": "^12.33.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.2.2",
    "minio": "^7.0.8",
    "mongodb": "^7.5.0",
    "multer": "^2.2.0",
    "pdf-lib": "^1.17.1",
    "serverless-http": "^3.2.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "globals": "^17.7.0"
  }
}
